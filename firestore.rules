rules_version = '2';

// Each reader may read and change only their own profile. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a CONFIRMED email. An email-and-password account that has not confirmed its email gets nothing,
    // so nobody can use an address they do not own. A session that came through Google is confirmed by Google itself.
    function signedIn() {
      return request.auth != null
        && !isDisposableEmail()
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // Throwaway-inbox domains (yopmail and the like) get nothing. Keep in step with DISPOSABLE_DOMAINS in lib/disposable-email.ts.
    // Only the exact domain is matched here; the sign-up form also rejects subdomains.
    function isDisposableEmail() {
      return 'email' in request.auth.token
        && request.auth.token.email.lower().split('@')[1] in ['yopmail.com', 'yopmail.fr', 'yopmail.net', 'cool.fr.nf', 'jetable.fr.nf', 'nospam.ze.tc', 'nomail.xl.cx', 'mega.zik.dj', 'speed.1s.fr', 'courriel.fr.nf', 'moncourrier.fr.nf', 'monemail.fr.nf', 'monmail.fr.nf', 'mailinator.com', 'mailinator.net', 'mailinator2.com', 'guerrillamail.com', 'guerrillamail.net', 'guerrillamail.org', 'guerrillamail.biz', 'guerrillamail.de', 'guerrillamailblock.com', 'grr.la', 'sharklasers.com', 'pokemail.net', 'spam4.me', '10minutemail.com', '10minutemail.net', '10minutemail.co.uk', '20minutemail.com', 'tempmail.com', 'temp-mail.org', 'temp-mail.io', 'tempmail.net', 'tempmail.dev', 'tempmailo.com', 'tempail.com', 'tempr.email', 'tempinbox.com', 'throwawaymail.com', 'trashmail.com', 'trashmail.net', 'trashmail.de', 'trash-mail.com', 'trashmail.io', 'trashmail.me', 'wegwerfmail.de', 'wegwerfmail.net', 'wegwerfmail.org', 'wegwerfemail.de', 'getnada.com', 'nada.email', 'maildrop.cc', 'mailnesia.com', 'mailcatch.com', 'mailnull.com', 'mailsac.com', 'mytemp.email', 'mohmal.com', 'moakt.com', 'moakt.cc', 'tmpmail.org', 'tmpmail.net', 'dispostable.com', 'fakeinbox.com', 'fakemail.net', 'fakemailgenerator.com', 'emailondeck.com', 'email-fake.com', 'emailfake.com', 'fake-mail.net', 'mintemail.com', 'mailtemp.net', 'mail-temp.com', 'spamgourmet.com', 'spambox.us', 'spamex.com', 'spam.la', 'spamfree24.org', 'spamhereplease.com', 'spamobox.com', 'mailforspam.com', 'incognitomail.com', 'incognitomail.org', 'discard.email', 'discardmail.com', 'discardmail.de', 'burnermail.io', 'anonbox.net', 'anonymbox.com', 'armyspy.com', 'cuvox.de', 'dayrep.com', 'einrot.com', 'fleckens.hu', 'gustr.com', 'jourrapide.com', 'rhyta.com', 'superrito.com', 'teleworm.us', 'harakirimail.com', 'inboxbear.com', 'inboxkitten.com', 'instant-mail.de', 'kasmail.com', 'luxusmail.org', 'mailexpire.com', 'mailme.lv', 'mailmoat.com', 'mailnator.com', 'mailzilla.com', 'meltmail.com', 'mt2015.com', 'mvrht.com', 'nowmymail.com', 'objectmail.com', 'owlymail.com', 'proxymail.eu', 'rcpt.at', 'safetymail.info', 'selfdestructingmail.com', 'sneakemail.com', 'snkmail.com', 'sogetthis.com', 'spoofmail.de', 'tafmail.com', 'tempemail.net', 'tempomail.fr', 'temporaryemail.net', 'tempsky.com', 'thankyou2010.com', 'trbvm.com', 'tyldd.com', 'veryrealemail.com', 'vomoto.com', 'wh4f.org', 'yepmail.net', 'zehnminuten.de', 'zippymail.info', 'emailtemporanea.com', 'emailtemporanea.net', 'crazymailing.com', 'dropmail.me', 'fexpost.com', 'fexbox.org', 'mailpoof.com', 'guerrillamail.info', 'linshiyouxiang.net', 'byom.de', '33mail.com', 'jnxjn.com', 'mailbox.in.ua', 'tmail.ws', 'tmailor.com', 'internxt.com', 'emlhub.com', 'emltmp.com', 'mail.tm', 'mailtothis.com', '1secmail.com', '1secmail.net', '1secmail.org', 'esiix.com', 'wwjmp.com', 'xojxe.com', 'yoggm.com', 'vjuum.com', 'laafd.com', 'txcct.com'];
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validName(v) {
      return v is string && v.size() >= 1 && v.size() <= 60;
    }

    // Keep these lists in step with EXPERIENCE_OPTIONS and GOAL_OPTIONS in lib/accounts.ts.
    function validExperience(v) {
      return v in ['', 'student', '0-1', '1-3', '3-5', '5-plus'];
    }

    function validGoal(v) {
      return v in ['', 'learn', 'interviews', 'level-up', 'career-switch', 'other'];
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // The profile is created automatically on the first sign-in.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['name', 'email', 'emailUpdates', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'experience', 'goal', 'emailUpdates', 'createdAt', 'updatedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.emailUpdates is bool
        && validExperience(request.resource.data.get('experience', ''))
        && validGoal(request.resource.data.get('goal', ''))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Email and creation date are fixed; the rest can change.
      allow update: if isOwner(uid)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['name', 'email', 'experience', 'goal', 'emailUpdates', 'createdAt', 'updatedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.emailUpdates is bool
        && validExperience(request.resource.data.get('experience', ''))
        && validGoal(request.resource.data.get('goal', ''))
        && request.resource.data.updatedAt == request.time;

      // Readers cannot delete their profile. Records are kept so the owner can see activity.
      allow delete: if false;
    }

    // Only the site owner may change badges. Keep this address in step with ADMIN_EMAIL in lib/admin.ts.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email.lower() == 'jainikpatel1743@gmail.com';
    }

    // Badges are data: any signed-in reader can read them, only the owner can write them.
    match /badges/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'track', 'metric', 'threshold', 'blurb', 'image', 'enabled', 'share'])
        && request.resource.data.keys().hasAll(['name', 'track', 'metric', 'threshold', 'image', 'enabled'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.track is string && request.resource.data.track.size() <= 30
        && request.resource.data.metric in ['activeDays', 'lessonsDone', 'streak']
        && request.resource.data.threshold is int && request.resource.data.threshold >= 1
        && request.resource.data.get('blurb', '') is string && request.resource.data.get('blurb', '').size() <= 200
        && request.resource.data.image is string && request.resource.data.image.size() <= 300000
        && request.resource.data.get('share', '') is string && request.resource.data.get('share', '').size() <= 500
        && request.resource.data.enabled is bool;
      allow delete: if isAdmin();
    }

    // Saved lessons: one record per reader holding a map of bookmarks. Only the reader can see or change it.
    match /bookmarks/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is map && request.resource.data.items.size() <= 500
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Private notes on lessons: one record per reader holding a map of notes. Only the reader can see or change it.
    // The client keeps each note to 2,000 characters and 200 notes; the 1 MB limit on a record is the hard stop.
    match /notes/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is map && request.resource.data.items.size() <= 200
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // The daily review queue: the quiz questions a reader missed and when each is due. One record per reader.
    match /reviews/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is map && request.resource.data.items.size() <= 400
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Where the reader left off ("Continue where you left off?"): one small record per reader.
    match /lastpage/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['path', 'title', 'at'])
        && request.resource.data.path is string && request.resource.data.path.matches('^/.*') && request.resource.data.path.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.at is number;
      allow delete: if false;
    }

    // One record per reader: finished lessons, the days they studied (badges are counted from these) and the next lesson.
    match /progress/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['done', 'days', 'next', 'log', 'updatedAt'])
        && request.resource.data.keys().hasAll(['done', 'days', 'updatedAt'])
        && request.resource.data.done is list && request.resource.data.done.size() <= 1000
        && request.resource.data.days is list && request.resource.data.days.size() <= 800
        && request.resource.data.get('log', {}) is map && request.resource.data.get('log', {}).size() <= 500
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.get('next', null) == null
            || (request.resource.data.next is map
                && request.resource.data.next.keys().hasOnly(['path', 'title'])));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
